      "start_s": 113,
      "end_s": 185,
      "duration_ms": 72000,
      "lines": [
        {
          "n": 1,
          "text": "Akranes. Falleg tútsýni, fallegt sólsetur og svakalega fallegt að geta séð sjóinn þegar maður vaknar.",
          "source": "place:3d9cd44e-4847-4e2a-9231-953f06c17d84",
          "start_s": 119.34,
          "end_s": 123.9,
          "fidelity": 0.2,
          "expected_words": 15,
          "matched_words": 3
        },
        {
          "n": 2,
          "text": "Tálknafjörður. þar var ég öll sumur sem krakki hjá ömmu minni, frelsi og ævintýri",
          "source": "place:a42ef66d-2df7-4602-a2a6-073f1406b041",
          "start_s": 126.06,
          "end_s": 131.92,
          "fidelity": 0.9285714285714286,
          "expected_words": 14,
          "matched_words": 13
        },
        {
          "n": 3,
          "text": "Hesteyri. Þetta er staðurinn sem hugurinn heimsækir þegar erfiðleikar steðja.",
          "source": "place:225dfddb-2f68-41f3-8a5f-a6ec93ac8e32",
          "start_s": 133.5,
          "end_s": 134.96,
          "fidelity": 0.4,
          "expected_words": 10,
          "matched_words": 4
        },
        {
          "n": 4,
          "text": "Reynistaður. Því það er gaman þar",
          "source": "place:49d9ec15-7433-49d6-82a5-64deaccd5292",
          "start_s": 142.16,
          "end_s": 145.08,
          "fidelity": 1,
          "expected_words": 6,
          "matched_words": 6
        },
        {
          "n": 5,
          "text": "blóðberg, Íslenski hesturinn",
          "source": "islenskast:hraun; islenskast:dyr",
          "start_s": 146.12,
          "end_s": 149.02,
          "fidelity": 1,
          "expected_words": 3,
          "matched_words": 3
        },
        {
          "n": 6,
          "text": "Hálendi Sauðkindin, Töfrar hálendisins",
          "source": "islenskast:halendi,dyr; islenskast:halendi",
          "start_s": 152.5,
          "end_s": 153.68,
          "fidelity": 0.5,
          "expected_words": 4,
          "matched_words": 2
        },
        {
          "n": 7,
          "text": "Svarfaðardalur. Hér lærði ég falleg samskipti, kynntist ég plöntutegundunum og lærði að elska náttúruna og manneskjuna",
          "source": "place:65ce88ed-e98b-4542-90ab-6edc2672aa0b",
          "start_s": 154.22,
          "end_s": 163.86,
          "fidelity": 0.875,
          "expected_words": 16,
          "matched_words": 14
        },
        {
          "n": 8,
          "text": "Ásbyrgi. Þetta er hófur Sleipnis",
          "source": "place:81741d0a-7c1f-4d39-b364-b8e29440cb99",
          "start_s": 164.66,
          "end_s": 167.64,
          "fidelity": 1,
          "expected_words": 5,
          "matched_words": 5
        },
        {
          "n": 9,
          "text": "Grímastaðir á fjöllum. það var ég uppalin að hluta og lærði að elska landið og virða",
          "source": "place:d7b23189-cad6-4d27-9f3b-5e3334b6d4ef",
          "start_s": 169.4,
          "end_s": 174.4,
          "fidelity": 0.875,
          "expected_words": 16,
          "matched_words": 14
        },
        {
          "n": 10,
          "text": "Víkurnes. Ég á frábærar minningar af langafa mínum í þessu húsi og útsýnið er frábært. Sérstaklega þegar það er blækyrrt",
          "source": "place:dc31c706-5f7e-42b4-9559-0ea82a408e7e",
          "start_s": 175.04,
          "end_s": 181.94,
          "fidelity": 0.95,
          "expected_words": 20,
          "matched_words": 19
        }
      ]
    },
